{
  "name": "pascal-flowchart",
  "version": "0.0.1",
  "type": "module",
  "description": "Pascal → Блок-схема",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --config.win.signAndEditExecutable=false",
    "dist32": "electron-builder --win nsis --ia32 --config.win.signAndEditExecutable=false",
    "dist:win64": "electron-builder --win nsis --x64 --config.win.signAndEditExecutable=false",
    "dist:win32": "electron-builder --win nsis --ia32 --config.win.signAndEditExecutable=false",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "dist:mac": "electron-builder --mac dmg --x64"
  },
  "author": "Team IP-301",
  "homepage": "https://github.com/pascal-flowchart",
  "license": "MIT",
  "devDependencies": {
    "docx": "^9.7.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.pascal.flowchart",
    "productName": "Pascal Блок-схема",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "style.css",
      "app.js",
      "pascal-lexer.js",
      "pascal-parser.js",
      "flowchart-generator.js",
      "flowchart-renderer.js",
      "lib/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "Development",
      "maintainer": "Team IP-301"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
